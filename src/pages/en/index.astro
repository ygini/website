---
import Layout from '~/layouts/Layout.astro';
import ActivityCard from '~/components/ActivityCard.astro';
import { localizedPath } from '~/lib/paths';
import { personJsonLd, professionalServiceJsonLd } from '~/lib/jsonld';

const locale = 'en' as const;
const title = 'Yoann Gini — IT consulting & ULM instruction';
const description =
  'Yoann Gini, independent IT consultant: Apple, security and mobility expert (macOS/iOS, MDM/IDP). Also a multiaxe ULM flight instructor. Sole proprietorship based in Grans, France.';
---

<Layout
  page="home"
  locale={locale}
  title={title}
  description={description}
  jsonLd={[personJsonLd(locale), professionalServiceJsonLd(locale)]}
>
  <section class="hero">
    <div class="container hero-inner">
      <span class="eyebrow">Sole proprietorship · Grans (13), France</span>
      <h1>Yoann Gini</h1>
      <p class="hero-tagline">
        IT consultant — <strong>Apple</strong>, <strong>security</strong> and
        <strong>mobility</strong> expert.
      </p>
      <p class="lead">
        I help organizations run their Apple information systems: macOS / iOS administration, fleet
        management (MDM), identity (IDP), directory services and security. A secondary ULM
        instruction activity rounds out my background.
      </p>

      <ul class="hero-facts">
        <li><strong>Apple Certified Trainer</strong> since 2007</li>
        <li>International speaker (<strong>MacAdmins Conference</strong>)</li>
        <li>Independent consultant — current primary engagement: <strong>Alectrona</strong></li>
        <li>Languages: French (native), English (professional)</li>
      </ul>

      <div class="hero-actions">
        <a class="btn btn--primary" href={localizedPath('it', locale)}>Explore IT consulting</a>
        <a class="btn btn--ghost" href={localizedPath('ulm', locale)}>ULM activity</a>
      </div>
    </div>
  </section>

  <section class="section section--surface">
    <div class="container">
      <div class="activities">
        <ActivityCard
          href={localizedPath('it', locale)}
          eyebrow="Primary activity"
          title="IT consulting"
          description="Outsourced CIO / CTO, Apple and security expert for SMBs, startups and education."
          points={[
            'macOS & iOS administration, MDM / IDP',
            'Directory services, identity and mobility',
            'Security, reverse engineering, IS architecture',
          ]}
          cta="See skills and portfolio"
          featured
        />
        <ActivityCard
          href={localizedPath('ulm', locale)}
          eyebrow="Occasional activity"
          title="ULM instruction (multiaxe)"
          description="Instructor and director, practised occasionally in the ULM world."
          points={[
            'Instructor of pilots and of instructors',
            'Competition course director',
            'Flight director for air shows',
          ]}
          cta="See the ULM activity"
        />
      </div>
    </div>
  </section>
</Layout>

<style>
  .hero {
    padding-block: clamp(3rem, 8vw, 6rem);
    background:
      radial-gradient(60% 120% at 100% 0%, var(--accent-soft), transparent 60%),
      var(--bg);
  }
  .hero-inner {
    max-width: 52rem;
  }
  .hero h1 {
    font-size: clamp(2.6rem, 7vw, 4.5rem);
    margin: 0.2rem 0 0.4rem;
  }
  .hero-tagline {
    font-family: var(--font-serif);
    font-size: clamp(1.3rem, 3vw, 1.9rem);
    color: var(--text);
    margin: 0 0 1rem;
  }
  .hero .lead {
    max-width: 54ch;
  }
  .hero-facts {
    list-style: none;
    display: grid;
    gap: 0.5rem;
    margin: 1.5rem 0 0;
  }
  .hero-facts li {
    position: relative;
    padding-left: 1.5rem;
    color: var(--muted);
  }
  .hero-facts li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.55em;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--accent);
  }
  .hero-facts strong {
    color: var(--text);
  }
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2rem;
  }
  .activities {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: clamp(1rem, 3vw, 1.75rem);
  }
  @media (max-width: 720px) {
    .activities {
      grid-template-columns: 1fr;
    }
  }
</style>
