---
import { type Locale, localizedPath } from '~/lib/paths';
import { useTranslations, SOCIAL_LINKS, CONTACT_EMAIL } from '~/i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const year = new Date().getFullYear();

const nav = [
  { href: localizedPath('home', locale), label: t('nav.home') },
  { href: localizedPath('it', locale), label: t('nav.it') },
  { href: localizedPath('ulm', locale), label: t('nav.ulm') },
  { href: localizedPath('legal', locale), label: t('nav.legal') },
];

const elsewhere = [
  { href: SOCIAL_LINKS.github, label: 'GitHub' },
  { href: SOCIAL_LINKS.linkedin, label: 'LinkedIn' },
  { href: SOCIAL_LINKS.nostradamus, label: 'Aéroclub Nostradamus' },
  { href: SOCIAL_LINKS.ffplum, label: 'FFPLUM' },
];
---

<footer class="site-footer">
  <div class="container footer-grid">
    <div class="footer-brand">
      <span class="brand-mark" aria-hidden="true">YG</span>
      <p class="footer-name">Yoann Gini</p>
      <p class="muted footer-role">{t('footer.role')}</p>
      <p class="muted footer-entity">{t('footer.entity')} · SIRET 501 741 615 00030</p>
    </div>

    <nav class="footer-col" aria-label={t('footer.nav')}>
      <h2>{t('footer.nav')}</h2>
      <ul>
        {nav.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
      </ul>
    </nav>

    <div class="footer-col">
      <h2>{t('footer.elsewhere')}</h2>
      <ul>
        {
          elsewhere.map((item) => (
            <li>
              <a href={item.href} rel="me noopener" target="_blank">
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="footer-col">
      <h2>{t('footer.contact')}</h2>
      <ul>
        <li><a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a></li>
        <li class="muted">Grans (13), France</li>
      </ul>
    </div>
  </div>

  <div class="container footer-legal">
    <p class="muted">© {year} Yoann Gini. {t('footer.rights')}</p>
    <p class="muted">{t('footer.privacy')}</p>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: auto;
    background: var(--surface);
    border-top: 1px solid var(--border);
    padding-block: clamp(2.5rem, 5vw, 3.5rem) 1.5rem;
  }
  .footer-grid {
    display: grid;
    grid-template-columns: 1.4fr 1fr 1fr 1fr;
    gap: 2rem;
  }
  .brand-mark {
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    border-radius: 10px;
    background: linear-gradient(135deg, var(--accent), var(--accent-strong));
    color: #fff;
    font-family: var(--font-serif);
    margin-bottom: 0.7rem;
  }
  .footer-name {
    font-family: var(--font-serif);
    font-size: 1.15rem;
    font-weight: 700;
    margin: 0;
  }
  .footer-role,
  .footer-entity {
    margin: 0.2rem 0 0;
    font-size: 0.9rem;
  }
  .footer-col h2 {
    font-family: var(--font-sans);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
    margin: 0.4rem 0 0.8rem;
  }
  .footer-col ul {
    list-style: none;
    display: grid;
    gap: 0.5rem;
  }
  .footer-col a {
    color: var(--text);
    font-size: 0.95rem;
    text-decoration: none;
  }
  .footer-col a:hover {
    color: var(--accent);
  }
  .footer-legal {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem;
    margin-top: 2.5rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--border);
    font-size: 0.85rem;
  }
  .footer-legal p {
    margin: 0;
  }

  @media (max-width: 760px) {
    .footer-grid {
      grid-template-columns: 1fr 1fr;
    }
    .footer-brand {
      grid-column: 1 / -1;
    }
  }
  @media (max-width: 460px) {
    .footer-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
