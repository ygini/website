---
import { type Locale, type PageId, localizedPath, otherLocale } from '~/lib/paths';
import { useTranslations } from '~/i18n/ui';

interface Props {
  page: PageId;
  locale: Locale;
}

const { page, locale } = Astro.props;
const t = useTranslations(locale);
const other = otherLocale(locale);

const nav: { id: PageId; href: string; label: string }[] = [
  { id: 'home', href: localizedPath('home', locale), label: t('nav.home') },
  { id: 'it', href: localizedPath('it', locale), label: t('nav.it') },
  { id: 'ulm', href: localizedPath('ulm', locale), label: t('nav.ulm') },
];

const switchHref = localizedPath(page, other);
const homeHref = localizedPath('home', locale);
---

<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href={homeHref} aria-label="Yoann Gini">
      <span class="brand-mark" aria-hidden="true">YG</span>
      <span class="brand-name">Yoann Gini</span>
    </a>

    <nav class="site-nav" aria-label={locale === 'fr' ? 'Navigation principale' : 'Main navigation'}>
      <ul>
        {
          nav.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={item.id === page ? 'page' : undefined}
                class={item.id === page ? 'is-active' : undefined}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <a class="lang-switch" href={switchHref} hreflang={other} aria-label={t('lang.switchLabel')}>
      {t('lang.switchTo')}
    </a>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--bg) 88%, transparent);
    backdrop-filter: saturate(160%) blur(10px);
    border-bottom: 1px solid var(--border);
  }
  .header-inner {
    display: flex;
    align-items: center;
    gap: 1rem;
    min-height: 64px;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    color: var(--text);
    font-weight: 700;
    text-decoration: none;
  }
  .brand-mark {
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border-radius: 9px;
    background: linear-gradient(135deg, var(--accent), var(--accent-strong));
    color: #fff;
    font-family: var(--font-serif);
    font-size: 0.95rem;
    letter-spacing: -0.5px;
  }
  .brand-name {
    font-family: var(--font-serif);
    font-size: 1.1rem;
  }
  .site-nav {
    margin-left: auto;
  }
  .site-nav ul {
    display: flex;
    gap: clamp(0.6rem, 2vw, 1.4rem);
    list-style: none;
  }
  .site-nav a {
    color: var(--muted);
    font-weight: 600;
    font-size: 0.95rem;
    padding: 0.3rem 0.1rem;
    text-decoration: none;
    border-bottom: 2px solid transparent;
  }
  .site-nav a:hover,
  .site-nav a.is-active {
    color: var(--text);
    border-bottom-color: var(--accent);
  }
  .lang-switch {
    font-weight: 600;
    font-size: 0.85rem;
    color: var(--text);
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 0.35rem 0.8rem;
    text-decoration: none;
    white-space: nowrap;
  }
  .lang-switch:hover {
    border-color: var(--accent);
    color: var(--accent);
    text-decoration: none;
  }

  @media (max-width: 560px) {
    .brand-name {
      display: none;
    }
    .header-inner {
      gap: 0.6rem;
    }
  }
</style>
