---
interface Props {
  href: string;
  eyebrow: string;
  title: string;
  description: string;
  points?: string[];
  cta: string;
  featured?: boolean;
}

const { href, eyebrow, title, description, points = [], cta, featured } = Astro.props;
---

<a class={`activity ${featured ? 'activity--featured' : ''}`} href={href}>
  <span class="eyebrow">{eyebrow}</span>
  <h3>{title}</h3>
  <p class="muted">{description}</p>
  {
    points.length > 0 && (
      <ul class="activity-points">
        {points.map((p) => (
          <li>{p}</li>
        ))}
      </ul>
    )
  }
  <span class="activity-cta">
    {cta}
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
    </svg>
  </span>
</a>

<style>
  .activity {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    padding: clamp(1.4rem, 3vw, 2rem);
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-soft);
    color: var(--text);
    text-decoration: none;
    transition: transform 0.18s ease, box-shadow 0.18s ease, border-color 0.18s ease;
  }
  .activity:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow);
    border-color: color-mix(in srgb, var(--accent) 45%, var(--border));
    text-decoration: none;
  }
  .activity--featured {
    background: linear-gradient(180deg, var(--accent-soft), var(--bg) 65%);
    border-color: color-mix(in srgb, var(--accent) 30%, var(--border));
  }
  .activity h3 {
    font-size: clamp(1.3rem, 2.5vw, 1.7rem);
    margin: 0.1rem 0 0.2rem;
  }
  .activity-points {
    list-style: none;
    margin: 0.6rem 0 0;
    display: grid;
    gap: 0.35rem;
  }
  .activity-points li {
    position: relative;
    padding-left: 1.25rem;
    font-size: 0.95rem;
    color: var(--muted);
  }
  .activity-points li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.6em;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent);
  }
  .activity-cta {
    margin-top: auto;
    padding-top: 1.1rem;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-weight: 600;
    color: var(--accent);
  }
  .activity:hover .activity-cta svg {
    transform: translateX(3px);
  }
  .activity-cta svg {
    transition: transform 0.18s ease;
  }
</style>
