---
interface Props {
  id?: string;
  eyebrow?: string;
  title?: string;
  surface?: boolean;
  tight?: boolean;
  lead?: string;
}

const { id, eyebrow, title, surface, tight, lead } = Astro.props;
const classes = [
  'section',
  surface ? 'section--surface' : null,
  tight ? 'section--tight' : null,
]
  .filter(Boolean)
  .join(' ');
---

<section id={id} class={classes}>
  <div class="container">
    {
      (eyebrow || title || lead) && (
        <header class="section-head">
          {eyebrow && <span class="eyebrow">{eyebrow}</span>}
          {title && <h2>{title}</h2>}
          {lead && <p class="lead">{lead}</p>}
        </header>
      )
    }
    <slot />
  </div>
</section>

<style>
  .section-head {
    margin-bottom: clamp(1.5rem, 4vw, 2.5rem);
    max-width: 60ch;
  }
  .section-head .lead {
    margin-top: 0.25rem;
  }
</style>
